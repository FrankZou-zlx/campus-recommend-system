# ===== 云部署环境变量模板 =====
# 复制为 .env 并填写；本地开发可直接留默认（连本工作区隔离的本地 MySQL）。
# 上云时把 DB_* 改成 TiDB Serverless 等「MySQL 兼容云数据库」的连接信息即可，
# 后端代码（mysql2 + ? 占位符 + schema.sql）无需任何改动。

# —— 数据库（MySQL 兼容；本地默认即本工作区 MySQL） ——
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=campus
DB_PASSWORD=campus1234
DB_NAME=campus_mall

# —— 鉴权 ——
JWT_SECRET=请替换为随机长字符串（如 openssl rand -hex 32）

# —— 服务端口（Render/Vercel 等 PaaS 用环境变量注入，本地默认 3001） ——
PORT=3001

# —— 允许跨域的前端地址（用 Vercel 反向代理 /api 时同源，可不填；
#    若前端直连后端域名则填 Vercel 地址，如 https://campus-mall.vercel.app） ——
CLIENT_ORIGIN=http://localhost:5173
