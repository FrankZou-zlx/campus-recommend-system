# ============================================================
#  校园二手优选 · 后端环境变量（裸机部署）
#  安装位置：/etc/campus-mall/api.env
#  权限：640，属主 root:campus  —— 里面是数据库密码，别给全局读权限
#
#  改完记得：systemctl restart campus-mall-api
#  systemd 的 EnvironmentFile 语法：等号两边不要有空格，值不要加引号
# ============================================================

# ---- 监听端口（Nginx 反代到这个端口）----
PORT=3001

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=campus
DB_PASSWORD=campus1234
DB_NAME=campus_mall

# ---- JWT 签发密钥 ----
# 生成随机值：openssl rand -hex 32
JWT_SECRET=please-change-this-secret

# ---- 允许跨域的前端地址 ----
# 同源部署（Nginx 同时提供前端和 /api）时写服务器地址即可
CLIENT_ORIGIN=http://localhost

# ---- 账号状态缓存（毫秒）----
# auth 中间件每请求都要确认账号没被禁用，缓存 5 秒可省掉绝大多数只读查询。
# 管理员改状态时代码会主动清缓存，所以禁用仍是即时生效；留 5000 即可。
AUTH_CACHE_TTL_MS=5000

# ---- /metrics 额外白名单（可选，逗号分隔的 IP）----
# 默认已放行 loopback 与 RFC1918 私网；Prometheus 从 127.0.0.1 抓取，无需填。
# 只有监控机在另一个网段时才需要把它的 IP 加进来。
METRICS_ALLOW=
