# ============================================================
#  校园二手优选 · 前端镜像（Nginx 托管纯静态站点）
#  前端是「免构建」方案（vendor/ 里已内置 vue / element-plus / axios），
#  所以不需要 npm build，直接把文件拷进 Nginx 的站点根目录即可。
#  构建：docker build -f deploy/docker/Dockerfile.frontend -t campus-mall-web .
# ============================================================
FROM nginx:1.27-alpine

ENV TZ=Asia/Shanghai

# 站点配置（静态 + /api 与 /uploads 反向代理到 api 容器）
COPY deploy/docker/nginx-docker.conf /etc/nginx/conf.d/default.conf

# 正式站（校园二手优选）
COPY frontend/ /usr/share/nginx/html/

# 公开演示版（浏览器内置协同过滤的免后端版本，访问 /demo/ 查看；不需要可删掉这两行）
COPY demo-dist/ /usr/share/nginx/html/demo/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
