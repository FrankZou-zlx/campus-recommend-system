# ============================================================
#  校园二手优选 · Docker Compose 环境变量
#  用法：cp .env.example .env  然后按需修改（至少改掉三个密码）
#  注意：compose 会自动读取同目录下的 .env，不要提交真实密码到公开仓库
# ============================================================

# ---- 数据库 ----
DB_ROOT_PASSWORD=root1234
DB_NAME=campus_mall
DB_USER=campus
DB_PASSWORD=campus1234

# ---- 后端 ----
# 生成随机密钥：openssl rand -hex 32
JWT_SECRET=please-change-this-secret
# 浏览器访问系统的地址（用于跨域白名单；同源部署填 http://服务器IP 即可）
CLIENT_ORIGIN=http://localhost

# ---- 对外端口 ----
# 改成 8080 就用 http://服务器IP:8080/ 访问（80 被占用时很方便）
WEB_PORT=80
